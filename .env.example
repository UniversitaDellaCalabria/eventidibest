# Copia questo file in .env e compila con i tuoi valori reali
# NON committare mai il file .env su Git

DB_HOST=localhost
DB_USER=db_username
DB_PASS=db_password
DB_NAME=eventi_dibest
SIMPLESAML_PATH=/opt/simplesamlphp/lib/_autoload.php

# Chiave per avviare i cron via URL (wget/curl): script.php?key=CHIAVE
# Almeno 16 caratteri casuali. Non serve se il crontab usa "php /percorso/script.php".
CRON_KEY=
